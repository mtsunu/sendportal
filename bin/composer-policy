#!/usr/bin/env php
<?php

declare(strict_types=1);

const COMPOSER_RELEASE = '2.10.2';
const COMPOSER_PHAR_NAME = 'composer-2.10.2.phar';
const COMPOSER_RECORD_NAME = 'composer-2.10.2.phar.sha256';
const COMPOSER_RELEASE_URL = 'https://getcomposer.org/download/2.10.2/composer.phar';
const COMPOSER_CHECKSUM_VERIFICATION = 'separately downloaded official SHA-256 from https://getcomposer.org/download/2.10.2/composer.phar.sha256sum';

function reject(string $message): never
{
    fwrite(STDERR, "Composer policy guard: {$message}\n");

    exit(1);
}

/**
 * @param list<string> $command
 * @return array{int, string}
 */
function runComposer(array $command): array
{
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);

    if (! is_resource($process)) {
        reject('Composer distribution unavailable.');
    }

    $output = stream_get_contents($pipes[1]).stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);

    return [proc_close($process), $output];
}

function isReadableRegularFile(string $path): bool
{
    $stat = @lstat($path);

    return is_array($stat)
        && (($stat['mode'] & 0170000) === 0100000)
        && is_readable($path);
}

/**
 * @return array{phar: string, record: string}
 */
function repositoryDistributionPaths(): array
{
    $scriptPath = realpath(__FILE__);

    if ($scriptPath === false) {
        reject('Composer distribution unavailable.');
    }

    $repositoryRoot = realpath(dirname($scriptPath).'/..');

    if ($repositoryRoot === false) {
        reject('Composer distribution unavailable.');
    }

    return [
        'phar' => $repositoryRoot.'/tools/composer/'.COMPOSER_PHAR_NAME,
        'record' => $repositoryRoot.'/tools/composer/'.COMPOSER_RECORD_NAME,
    ];
}

function verifiedComposerPath(): string
{
    $paths = repositoryDistributionPaths();

    if (! isReadableRegularFile($paths['phar']) || ! isReadableRegularFile($paths['record'])) {
        reject('Composer distribution unavailable.');
    }

    $record = file($paths['record'], FILE_IGNORE_NEW_LINES);

    if ($record === false || count($record) !== 4) {
        reject('Composer distribution integrity verification failed.');
    }

    $expectedLines = [
        'release: '.COMPOSER_RELEASE,
        'source: '.COMPOSER_RELEASE_URL,
        'verification: '.COMPOSER_CHECKSUM_VERIFICATION,
    ];

    foreach ($expectedLines as $index => $line) {
        if (($record[$index] ?? null) !== $line) {
            reject('Composer distribution integrity verification failed.');
        }
    }

    if (preg_match('/^([a-f0-9]{64})\s+'.preg_quote(COMPOSER_PHAR_NAME, '/').'$/D', $record[3], $matches) !== 1) {
        reject('Composer distribution integrity verification failed.');
    }

    $actualDigest = hash_file('sha256', $paths['phar']);

    if (! is_string($actualDigest) || ! hash_equals($matches[1], $actualDigest)) {
        reject('Composer distribution integrity verification failed.');
    }

    return $paths['phar'];
}

/**
 * @param list<string> $arguments
 */
function rejectOverrides(array $arguments): void
{
    foreach (['COMPOSER_BIN', 'COMPOSER', 'COMPOSER_POLICY', 'COMPOSER_NO_AUDIT', 'COMPOSER_NO_BLOCKING', 'COMPOSER_NO_SECURITY_BLOCKING', 'COMPOSER_IGNORE_PLATFORM_REQ', 'COMPOSER_IGNORE_PLATFORM_REQS'] as $name) {
        $value = getenv($name);

        if (is_string($value) && $value !== '') {
            reject('Composer override rejected.');
        }
    }

    foreach ($arguments as $argument) {
        foreach (['--ignore-platform-req', '--ignore-platform-reqs', '--no-blocking', '--no-security-blocking', '--no-audit'] as $option) {
            if ($argument === $option || str_starts_with($argument, $option.'=')) {
                reject('Composer override rejected.');
            }
        }
    }
}

function hasExactComposerVersion(string $output): bool
{
    return preg_match('/^Composer version '.preg_quote(COMPOSER_RELEASE, '/').'(?:\s|$)/mi', $output) === 1;
}

if (PHP_SAPI !== 'cli') {
    reject('this command must run from the CLI.');
}

$arguments = array_values(array_slice($argv, 1));

if ($arguments === []) {
    reject('a Composer command is required.');
}

rejectOverrides($arguments);
$composerPath = verifiedComposerPath();

[$versionStatus, $versionOutput] = runComposer([PHP_BINARY, $composerPath, '--version', '--no-interaction']);

if ($versionStatus !== 0 || ! hasExactComposerVersion($versionOutput)) {
    reject('Composer distribution version verification failed.');
}

[$policyStatus] = runComposer([PHP_BINARY, $composerPath, 'policy', '--help', '--no-interaction']);

if ($policyStatus !== 0) {
    reject('Composer distribution policy capability unavailable.');
}

[$exitStatus, $delegatedOutput] = runComposer([PHP_BINARY, $composerPath, ...$arguments]);

fwrite(STDOUT, $delegatedOutput);

exit($exitStatus);

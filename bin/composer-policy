#!/usr/bin/env php
<?php

declare(strict_types=1);

const COMPOSER_RELEASE = '2.10.2';
const COMPOSER_PHAR_NAME = 'composer-2.10.2.phar';
const COMPOSER_RECORD_NAME = 'composer-2.10.2.phar.sha256';
const COMPOSER_RELEASE_URL = 'https://getcomposer.org/download/2.10.2/composer.phar';
const COMPOSER_CHECKSUM_VERIFICATION = 'separately downloaded official SHA-256 from https://getcomposer.org/download/2.10.2/composer.phar.sha256sum';
const COMPOSER_PREFLIGHT_CHANNEL_LIMIT = 262144;
const COMPOSER_PREFLIGHT_TIMEOUT_SECONDS = 10.0;

function reject(string $message): never
{
    fwrite(STDERR, "Composer policy guard: {$message}\n");

    exit(1);
}

/**
 * @param list<string> $command
 * @param array<string, string> $environment
 * @return array{status: int, stdout: string, stderr: string}
 */
function runComposerProbe(array $command, string $repositoryRoot, array $environment): array
{
    $process = proc_open(
        $command,
        [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes,
        $repositoryRoot,
        $environment,
    );

    if (! is_resource($process)) {
        reject('Composer preflight failed.');
    }

    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);
    $stdout = '';
    $stderr = '';
    $deadline = microtime(true) + COMPOSER_PREFLIGHT_TIMEOUT_SECONDS;
    $lastStatus = null;
    $failed = false;

    while (true) {
        $read = [];

        foreach ([1, 2] as $descriptor) {
            if (! feof($pipes[$descriptor])) {
                $read[] = $pipes[$descriptor];
            }
        }

        if ($read !== []) {
            $write = null;
            $except = null;
            @stream_select($read, $write, $except, 0, 100000);

            foreach ($read as $stream) {
                $chunk = stream_get_contents($stream);

                if ($stream === $pipes[1]) {
                    $stdout .= $chunk;
                    $failed = strlen($stdout) > COMPOSER_PREFLIGHT_CHANNEL_LIMIT;
                } else {
                    $stderr .= $chunk;
                    $failed = strlen($stderr) > COMPOSER_PREFLIGHT_CHANNEL_LIMIT;
                }

                if ($failed) {
                    break 2;
                }
            }
        }

        $lastStatus = proc_get_status($process);

        if (! $lastStatus['running'] && feof($pipes[1]) && feof($pipes[2])) {
            break;
        }

        if (microtime(true) >= $deadline) {
            $failed = true;

            break;
        }
    }

    if ($failed) {
        proc_terminate($process);
    }

    foreach ([1, 2] as $descriptor) {
        fclose($pipes[$descriptor]);
    }

    $closedStatus = proc_close($process);

    if ($failed) {
        reject('Composer preflight failed.');
    }

    $exitStatus = $closedStatus;

    if ($exitStatus < 0 && is_array($lastStatus) && is_int($lastStatus['exitcode']) && $lastStatus['exitcode'] >= 0) {
        $exitStatus = $lastStatus['exitcode'];
    }

    return ['status' => $exitStatus, 'stdout' => $stdout, 'stderr' => $stderr];
}

/**
 * @param list<string> $command
 * @param array<string, string> $environment
 */
function delegateComposer(array $command, string $repositoryRoot, array $environment): int
{
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $repositoryRoot,
        $environment,
    );

    if (! is_resource($process)) {
        reject('Composer distribution unavailable.');
    }

    return proc_close($process);
}

function removeComposerHome(string $path): void
{
    if (! is_dir($path)) {
        return;
    }

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );

    foreach ($iterator as $item) {
        $item->isDir() ? @rmdir($item->getPathname()) : @unlink($item->getPathname());
    }

    @rmdir($path);
}

/**
 * @return array{home: string, environment: array<string, string>}
 */
function isolatedComposerEnvironment(): array
{
    $home = sys_get_temp_dir().'/sendportal-composer-home-'.bin2hex(random_bytes(16));

    if (! mkdir($home, 0700) || ! chmod($home, 0700)) {
        reject('Composer isolated home unavailable.');
    }

    $stat = @lstat($home);

    if (! is_array($stat) || (($stat['mode'] & 0777) !== 0700)) {
        removeComposerHome($home);
        reject('Composer isolated home unavailable.');
    }

    register_shutdown_function(static function () use ($home): void {
        removeComposerHome($home);
    });

    $environment = getenv();

    if (! is_array($environment)) {
        removeComposerHome($home);
        reject('Composer isolated environment unavailable.');
    }

    $environment['COMPOSER_HOME'] = $home;

    return ['home' => $home, 'environment' => $environment];
}

function isReadableRegularFile(string $path): bool
{
    $stat = @lstat($path);

    return is_array($stat)
        && (($stat['mode'] & 0170000) === 0100000)
        && is_readable($path);
}

/**
 * @return array{root: string, phar: string, record: string}
 */
function repositoryDistributionPaths(): array
{
    $scriptPath = realpath(__FILE__);

    if ($scriptPath === false) {
        reject('Composer distribution unavailable.');
    }

    $repositoryRoot = realpath(dirname($scriptPath).'/..');

    if ($repositoryRoot === false) {
        reject('Composer distribution unavailable.');
    }

    return [
        'root' => $repositoryRoot,
        'phar' => $repositoryRoot.'/tools/composer/'.COMPOSER_PHAR_NAME,
        'record' => $repositoryRoot.'/tools/composer/'.COMPOSER_RECORD_NAME,
    ];
}

/**
 * @param array{root: string, phar: string, record: string} $paths
 */
function verifiedComposerPath(array $paths): string
{
    if (! isReadableRegularFile($paths['phar']) || ! isReadableRegularFile($paths['record'])) {
        reject('Composer distribution unavailable.');
    }

    $record = file($paths['record'], FILE_IGNORE_NEW_LINES);

    if ($record === false || count($record) !== 4) {
        reject('Composer distribution integrity verification failed.');
    }

    $expectedLines = [
        'release: '.COMPOSER_RELEASE,
        'source: '.COMPOSER_RELEASE_URL,
        'verification: '.COMPOSER_CHECKSUM_VERIFICATION,
    ];

    foreach ($expectedLines as $index => $line) {
        if (($record[$index] ?? null) !== $line) {
            reject('Composer distribution integrity verification failed.');
        }
    }

    if (preg_match('/^([a-f0-9]{64})\s+'.preg_quote(COMPOSER_PHAR_NAME, '/').'$/D', $record[3], $matches) !== 1) {
        reject('Composer distribution integrity verification failed.');
    }

    $actualDigest = hash_file('sha256', $paths['phar']);

    if (! is_string($actualDigest) || ! hash_equals($matches[1], $actualDigest)) {
        reject('Composer distribution integrity verification failed.');
    }

    return $paths['phar'];
}

/**
 * @param list<string> $arguments
 */
function rejectOverrides(array $arguments): void
{
    foreach ([
        'COMPOSER_BIN',
        'COMPOSER',
        'COMPOSER_POLICY',
        'COMPOSER_NO_AUDIT',
        'COMPOSER_NO_BLOCKING',
        'COMPOSER_NO_SECURITY_BLOCKING',
        'COMPOSER_IGNORE_PLATFORM_REQ',
        'COMPOSER_IGNORE_PLATFORM_REQS',
        'COMPOSER_POLICY_ADVISORIES_BLOCK',
        'COMPOSER_POLICY_MALWARE_BLOCK',
        'COMPOSER_POLICY_ABANDONED_BLOCK',
        'COMPOSER_SECURITY_BLOCKING_ABANDONED',
        'COMPOSER_AUDIT_ABANDONED',
    ] as $name) {
        $value = getenv($name);

        if (is_string($value) && $value !== '') {
            reject('Composer override rejected.');
        }
    }

    foreach ($arguments as $argument) {
        if (
            $argument === '--working-dir'
            || str_starts_with($argument, '--working-dir=')
            || $argument === '-d'
            || str_starts_with($argument, '-d=')
            || (str_starts_with($argument, '-d') && strlen($argument) > 2)
        ) {
            reject('Composer override rejected.');
        }

        foreach (['--ignore-platform-req', '--ignore-platform-reqs', '--no-blocking', '--no-security-blocking', '--no-audit'] as $option) {
            if ($argument === $option || str_starts_with($argument, $option.'=')) {
                reject('Composer override rejected.');
            }
        }
    }
}

function hasExactComposerVersion(string $output): bool
{
    return preg_match('/^Composer version '.preg_quote(COMPOSER_RELEASE, '/').'(?:\s|$)/mi', $output) === 1;
}

function hasExactManifestPolicy(string $repositoryRoot): bool
{
    $contents = @file_get_contents($repositoryRoot.'/composer.json');

    if (! is_string($contents)) {
        return false;
    }

    try {
        $manifest = json_decode($contents, true, 512, JSON_THROW_ON_ERROR);
    } catch (JsonException) {
        return false;
    }

    if (! is_array($manifest)) {
        return false;
    }

    $require = $manifest['require'] ?? null;
    $requireDev = $manifest['require-dev'] ?? null;
    $config = $manifest['config'] ?? null;
    $policy = is_array($config) ? ($config['policy'] ?? null) : null;
    $advisories = is_array($policy) ? ($policy['advisories'] ?? null) : null;

    if (
        ! is_array($require)
        || ! is_array($requireDev)
        || ! is_array($config)
        || ! is_array($policy)
        || ! is_array($advisories)
        || ($require['php'] ?? null) !== '^8.2'
        || ($require['laravel/framework'] ?? null) !== '^11.0'
        || ($require['mettle/sendportal-core'] ?? null) !== '^3.0'
        || array_key_exists('roave/security-advisories', $require)
        || array_key_exists('roave/security-advisories', $requireDev)
        || array_key_exists('platform', $config)
        || array_key_exists('audit', $config)
        || ($policy['ignore-unreachable'] ?? null) !== false
        || ($advisories['block'] ?? null) !== true
        || ($advisories['audit'] ?? null) !== 'fail'
    ) {
        return false;
    }

    $policyKeys = array_keys($policy);
    $advisoryKeys = array_keys($advisories);
    sort($policyKeys);
    sort($advisoryKeys);

    if ($policyKeys !== ['advisories', 'ignore-unreachable'] || $advisoryKeys !== ['audit', 'block', 'ignore-id']) {
        return false;
    }

    $rationale = 'This internal-only application has residual risk accepted by the project owner. The exception expires at Phase 2 lockfile review or when a compatible stable SendPortal Core release permits a Laravel upgrade, whichever comes first.';
    $expectedIgnoreIds = [
        'PKSA-3r5d-mb8f-1qw9' => $rationale,
        'PKSA-m5cs-t1y6-qpcs' => $rationale,
        'PKSA-mdq4-51ck-6kdq' => $rationale,
    ];

    return ($advisories['ignore-id'] ?? null) === $expectedIgnoreIds;
}

if (PHP_SAPI !== 'cli') {
    reject('this command must run from the CLI.');
}

$arguments = array_values(array_slice($argv, 1));

if ($arguments === []) {
    reject('a Composer command is required.');
}

rejectOverrides($arguments);
$distribution = repositoryDistributionPaths();
$commandContractPath = $distribution['root'].'/tools/composer/ComposerPolicyCommandContract.php';

if (! isReadableRegularFile($commandContractPath)) {
    reject('Composer command contract unavailable.');
}

require $commandContractPath;

$commandDecision = ComposerPolicyCommandContract::decide($arguments);

if (! $commandDecision['allowed']) {
    reject('Composer command rejected.');
}

$isolatedEnvironment = isolatedComposerEnvironment();

if (in_array($commandDecision['command'], ['install', 'update'], true) && ! hasExactManifestPolicy($distribution['root'])) {
    reject('Composer manifest policy rejected.');
}

$composerPath = verifiedComposerPath($distribution);
$repositoryRoot = $distribution['root'];

$versionProbe = runComposerProbe([PHP_BINARY, $composerPath, '--version', '--no-interaction'], $repositoryRoot, $isolatedEnvironment['environment']);

if ($versionProbe['status'] !== 0 || ! hasExactComposerVersion($versionProbe['stdout']."\n".$versionProbe['stderr'])) {
    reject('Composer distribution version verification failed.');
}

$policyProbe = runComposerProbe([PHP_BINARY, $composerPath, 'policy', '--help', '--no-interaction'], $repositoryRoot, $isolatedEnvironment['environment']);

if ($policyProbe['status'] !== 0) {
    reject('Composer distribution policy capability unavailable.');
}

exit(delegateComposer([PHP_BINARY, $composerPath, ...$arguments], $repositoryRoot, $isolatedEnvironment['environment']));
